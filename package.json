{
  "name": "local-virtual-pr",
  "displayName": "Local Virtual PR",
  "description": "Review local AI changes like a pull request while keeping VS Code symbol navigation available.",
  "version": "0.5.1",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/djm07073/local-virtual-pr.git"
  },
  "homepage": "https://github.com/djm07073/local-virtual-pr#readme",
  "bugs": {
    "url": "https://github.com/djm07073/local-virtual-pr/issues"
  },
  "keywords": [
    "codex",
    "local-pr",
    "code-review",
    "ai"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "activationEvents": [
    "onView:virtualPr.review"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "virtualPr.create",
        "title": "Virtual PR: Create or Reset",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "virtualPr.refresh",
        "title": "Virtual PR: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "virtualPr.openDiff",
        "title": "Virtual PR: Open Diff"
      },
      {
        "command": "virtualPr.openSource",
        "title": "Virtual PR: Open Navigable Source",
        "icon": "$(go-to-file)"
      },
      {
        "command": "virtualPr.markViewed",
        "title": "Virtual PR: Mark File as Viewed",
        "icon": "$(check)"
      },
      {
        "command": "virtualPr.unmarkViewed",
        "title": "Virtual PR: Mark File as Unviewed",
        "icon": "$(close)"
      },
      {
        "command": "virtualPr.addComment",
        "title": "Virtual PR: Add Review Comment",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "virtualPr.editComment",
        "title": "Virtual PR: Edit Review Comment",
        "icon": "$(edit)"
      },
      {
        "command": "virtualPr.resolveComment",
        "title": "Virtual PR: Resolve Comment",
        "icon": "$(check)"
      },
      {
        "command": "virtualPr.reopenComment",
        "title": "Virtual PR: Reopen Comment",
        "icon": "$(debug-restart)"
      },
      {
        "command": "virtualPr.askAI",
        "title": "Virtual PR: Ask AI to Implement",
        "icon": "$(hubot)"
      },
      {
        "command": "virtualPr.sendReview",
        "title": "Virtual PR: Send Review to AI",
        "icon": "$(send)"
      },
      {
        "command": "virtualPr.replyToComment",
        "title": "Reply and Send to Codex",
        "icon": "$(send)"
      },
      {
        "command": "virtualPr.approve",
        "title": "Virtual PR: Approve Locally",
        "icon": "$(pass-filled)"
      },
      {
        "command": "virtualPr.showOutput",
        "title": "Virtual PR: Show AI Output",
        "icon": "$(output)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "virtualPr",
          "title": "Virtual PR",
          "icon": "media/branch.svg"
        }
      ]
    },
    "views": {
      "virtualPr": [
        {
          "id": "virtualPr.review",
          "name": "Local Review"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "virtualPr.create",
          "when": "view == virtualPr.review",
          "group": "navigation@1"
        },
        {
          "command": "virtualPr.refresh",
          "when": "view == virtualPr.review",
          "group": "navigation@2"
        },
        {
          "command": "virtualPr.askAI",
          "when": "view == virtualPr.review",
          "group": "navigation@3"
        },
        {
          "command": "virtualPr.sendReview",
          "when": "view == virtualPr.review",
          "group": "navigation@4"
        },
        {
          "command": "virtualPr.approve",
          "when": "view == virtualPr.review",
          "group": "navigation@5"
        },
        {
          "command": "virtualPr.showOutput",
          "when": "view == virtualPr.review",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "virtualPr.openSource",
          "when": "view == virtualPr.review && viewItem == virtualPr.change.unviewed",
          "group": "inline@1"
        },
        {
          "command": "virtualPr.openSource",
          "when": "view == virtualPr.review && viewItem == virtualPr.change.viewed",
          "group": "inline@1"
        },
        {
          "command": "virtualPr.markViewed",
          "when": "view == virtualPr.review && viewItem == virtualPr.change.unviewed",
          "group": "inline@2"
        },
        {
          "command": "virtualPr.unmarkViewed",
          "when": "view == virtualPr.review && viewItem == virtualPr.change.viewed",
          "group": "inline@2"
        },
        {
          "command": "virtualPr.resolveComment",
          "when": "view == virtualPr.review && viewItem == virtualPr.comment.open",
          "group": "inline@1"
        },
        {
          "command": "virtualPr.resolveComment",
          "when": "view == virtualPr.review && viewItem == virtualPr.comment.outdated",
          "group": "inline@1"
        },
        {
          "command": "virtualPr.reopenComment",
          "when": "view == virtualPr.review && viewItem == virtualPr.comment.resolved",
          "group": "inline@1"
        },
        {
          "command": "virtualPr.editComment",
          "when": "view == virtualPr.review && viewItem == virtualPr.comment.open",
          "group": "inline@2"
        },
        {
          "command": "virtualPr.editComment",
          "when": "view == virtualPr.review && viewItem == virtualPr.comment.outdated",
          "group": "inline@2"
        },
        {
          "command": "virtualPr.editComment",
          "when": "view == virtualPr.review && viewItem == virtualPr.comment.resolved",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "command": "virtualPr.addComment",
          "when": "resourceScheme == file && editorTextFocus",
          "group": "virtualPr@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "virtualPr.addComment",
          "when": "commentController == localVirtualPr && commentThreadIsEmpty",
          "group": "inline"
        },
        {
          "command": "virtualPr.replyToComment",
          "when": "commentController == localVirtualPr && commentThread == virtualPr.comment.open",
          "group": "inline"
        },
        {
          "command": "virtualPr.replyToComment",
          "when": "commentController == localVirtualPr && commentThread == virtualPr.comment.outdated",
          "group": "inline"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "virtualPr.resolveComment",
          "when": "commentController == localVirtualPr && commentThread == virtualPr.comment.open",
          "group": "navigation@1"
        },
        {
          "command": "virtualPr.resolveComment",
          "when": "commentController == localVirtualPr && commentThread == virtualPr.comment.outdated",
          "group": "navigation@1"
        },
        {
          "command": "virtualPr.reopenComment",
          "when": "commentController == localVirtualPr && commentThread == virtualPr.comment.resolved",
          "group": "navigation@1"
        }
      ],
      "comments/comment/title": [
        {
          "command": "virtualPr.editComment",
          "when": "commentController == localVirtualPr && comment == virtualPr.comment.editable",
          "group": "navigation"
        },
        {
          "command": "virtualPr.editComment",
          "when": "commentController == localVirtualPr && comment == virtualPr.reply.reviewer",
          "group": "navigation"
        }
      ],
      "comments/comment/context": [
        {
          "command": "virtualPr.editComment",
          "when": "commentController == localVirtualPr && comment == virtualPr.comment.editable"
        },
        {
          "command": "virtualPr.editComment",
          "when": "commentController == localVirtualPr && comment == virtualPr.reply.reviewer"
        }
      ]
    },
    "configuration": {
      "title": "Local Virtual PR",
      "properties": {
        "virtualPr.defaultBaseRef": {
          "type": "string",
          "default": "",
          "description": "Default Git ref used as the Virtual PR base. Empty means auto-detect origin/HEAD, origin/main, main, or master."
        },
        "virtualPr.codexPath": {
          "type": "string",
          "default": "",
          "description": "Path to a Codex binary with app-server support. Empty means discover the binary bundled with the OpenAI extension or ChatGPT app."
        },
        "virtualPr.codexApprovalPolicy": {
          "type": "string",
          "enum": [
            "never",
            "on-request",
            "untrusted"
          ],
          "default": "never",
          "description": "Codex approval policy. The agent remains restricted to the current workspace."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "npm run compile && node --test dist/test/**/*.test.js",
    "package": "npm run test && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.2"
  }
}
